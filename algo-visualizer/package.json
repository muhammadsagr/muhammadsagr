{
  "name": "algo-visualizer",
  "version": "1.0.0",
  "description": "Interactive algorithm visualizer with cloud/DevOps algorithms, packaged with Docker, Kubernetes and Terraform.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check public/app.js",
    "build:standalone": "node scripts/build-standalone.mjs"
  }
}
